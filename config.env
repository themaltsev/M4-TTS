# Edge TTS neural voice and speech shaping. Use values accepted by Edge TTS:
# rate/volume as signed percentages (for example +10% or -5%), pitch as signed Hz.
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_CONNECT_TIMEOUT=10
EDGE_TTS_RECEIVE_TIMEOUT=60

# mpv playback controls. Speed 1.0 is normal; 1.35 preserves the current setting.
MPV_PLAYBACK_SPEED=1.35
MPV_PLAYBACK_VOLUME=100

# Cue volume is mpv percent (0-100); tick volume is a libcanberra dB value.
CUE_VOLUME=100
TICK_VOLUME_DB=-12.0

# No-audio/network failures are retried with exponential backoff (seconds).
API_MAX_ATTEMPTS=3
API_RETRY_BASE_SECONDS=1.5
API_RETRY_MAX_SECONDS=8

# Sound filenames are resolved under ~/.local/share/selected-text-speech/sounds.
# Absolute paths are also accepted.
START_SOUND=speech-start.oga
CANCEL_SOUND=speech-cancel.oga
TICK_SOUND=openclaw-soft-tick.wav
