# The local Piper voice is the default; speech works offline after installation.
TTS_ENGINE=piper
PIPER_MODEL=models/ru_RU-irina-medium.onnx
# By default, speech speed is derived from MPV_PLAYBACK_SPEED without changing pitch.
# PIPER_LENGTH_SCALE=0.74
PIPER_VOLUME=1.0

# Optional online engine. Set TTS_ENGINE=edge and install requirements-edge.txt.
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_CONNECT_TIMEOUT=10
EDGE_TTS_RECEIVE_TIMEOUT=60

# The previous 1.35x pace is retained; Piper speeds up synthesis without pitch shift.
MPV_PLAYBACK_SPEED=1.35
MPV_PLAYBACK_VOLUME=100
CUE_VOLUME=100
TICK_VOLUME_DB=-12.0
API_MAX_ATTEMPTS=3
API_RETRY_BASE_SECONDS=1.5
API_RETRY_MAX_SECONDS=8
START_SOUND=speech-start.oga
CANCEL_SOUND=speech-cancel.oga
TICK_SOUND=openclaw-soft-tick.wav
